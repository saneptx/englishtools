{
  "name": "englishtools",
  "version": "1.0.0",
  "description": "桌面英语学习工具：系统划词英译汉、中文实时汉译英",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/ensure-electron.js && node scripts/build-mac-helper.js",
    "build:mac-helper": "node scripts/build-mac-helper.js",
    "predev": "node scripts/build-mac-helper.js",
    "predist": "node scripts/build-mac-helper.js",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "node scripts/build-mac-helper.js && npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "uiohook-napi@1.5.5": true
  },
  "productName": "English Tools",
  "build": {
    "appId": "com.englishtools.app",
    "productName": "English Tools",
    "afterSign": "scripts/mac-sign.js",
    "copyright": "MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "package.json",
      "!**/node_modules/uiohook-napi/{libuiohook,src}/**",
      "!**/node_modules/uiohook-napi/binding.gyp",
      "!**/node_modules/uiohook-napi/prebuilds/**",
      "**/node_modules/uiohook-napi/prebuilds/win32-${arch}/**",
      "!**/node_modules/**/{README,readme,CHANGELOG,changelog}*",
      "!**/node_modules/**/*.{md,map,d.ts}"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "native/bin/mac-input-tap",
          "to": "native/bin/mac-input-tap"
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "English Tools 需要通过「系统事件」读取选中的文字和输入框内容，用于划词翻译和打字译英。",
        "NSScreenCaptureUsageDescription": "English Tools 需要录制屏幕用于截图翻译和识别微信输入框。"
      },
      "files": [
        "package.json",
        "!**/node_modules/uiohook-napi/**"
      ]
    },
    "dmg": {
      "title": "English Tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "English Tools"
    },
    "electronLanguages": [
      "en",
      "en-US",
      "en_GB",
      "en-GB",
      "zh_CN",
      "zh-CN",
      "zh_TW",
      "zh-TW"
    ]
  }
}
