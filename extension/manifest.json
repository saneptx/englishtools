{
  "manifest_version": 3,
  "name": "English Tools 划词翻译",
  "version": "1.0.0",
  "description": "任意网页划词英译汉（选区下方显示）；弹窗输入中文实时译成英文",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://api.deepseek.com/*", "https://*.deepseek.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "English Tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
